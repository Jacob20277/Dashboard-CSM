// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  MEMBER
}

model User {
  id                 String        @id @default(cuid())
  name               String
  email              String        @unique
  passwordHash       String
  role               Role          @default(MEMBER)
  isActive           Boolean       @default(true)
  mustChangePassword Boolean       @default(true)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  activityLogs       ActivityLog[]
  shareTokens        ShareToken[]
  csatLinks          CsatLink[]
}

model Account {
  id            String         @id @default(cuid())
  name          String         @unique
  isActive      Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  activityLogs  ActivityLog[]
  csatLinks     CsatLink[]
  csatResponses CsatResponse[]
}

model Kra {
  id        String @id @default(cuid())
  name      String @unique
  sortOrder Int
  kpis      Kpi[]
}

model Kpi {
  id           String           @id @default(cuid())
  kraId        String
  kra          Kra              @relation(fields: [kraId], references: [id])
  name         String
  sortOrder    Int
  activityTags ActivityLogKpi[]

  @@unique([kraId, name])
}

model ActivityLog {
  id              String           @id @default(cuid())
  userId          String
  user            User             @relation(fields: [userId], references: [id])
  accountId       String
  account         Account          @relation(fields: [accountId], references: [id])
  title           String           @default("Untitled")
  activityDate    DateTime         @db.Date
  durationMinutes Int
  notes           String?
  isUnmatched     Boolean          @default(true)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  kpiTags         ActivityLogKpi[]

  @@index([userId, activityDate])
  @@index([accountId])
  @@index([isUnmatched])
}

model ActivityLogKpi {
  activityLogId String
  activityLog   ActivityLog @relation(fields: [activityLogId], references: [id], onDelete: Cascade)
  kpiId         String
  kpi           Kpi         @relation(fields: [kpiId], references: [id])
  createdAt     DateTime    @default(now())

  @@id([activityLogId, kpiId])
}

model ShareToken {
  id              String    @id @default(cuid())
  token           String    @unique
  label           String?
  createdByUserId String
  createdBy       User      @relation(fields: [createdByUserId], references: [id])
  createdAt       DateTime  @default(now())
  revokedAt       DateTime?
  lastAccessedAt  DateTime?
}

model CsatLink {
  id              String             @id @default(cuid())
  token           String             @unique
  accountId       String
  account         Account            @relation(fields: [accountId], references: [id])
  createdByUserId String
  createdBy       User               @relation(fields: [createdByUserId], references: [id])
  createdAt       DateTime           @default(now())
  revokedAt       DateTime?
  questions       CsatLinkQuestion[]
  responses       CsatResponse[]

  @@index([accountId])
}

model CsatLinkQuestion {
  id         String       @id @default(cuid())
  csatLinkId String
  csatLink   CsatLink     @relation(fields: [csatLinkId], references: [id], onDelete: Cascade)
  text       String
  sortOrder  Int
  answers    CsatAnswer[]

  @@index([csatLinkId])
}

model CsatResponse {
  id             String       @id @default(cuid())
  csatLinkId     String
  csatLink       CsatLink     @relation(fields: [csatLinkId], references: [id])
  accountId      String
  account        Account      @relation(fields: [accountId], references: [id])
  comment        String?
  respondentName String?
  submittedAt    DateTime     @default(now())
  answers        CsatAnswer[]

  @@index([accountId])
  @@index([csatLinkId])
}

model CsatAnswer {
  id                 String           @id @default(cuid())
  csatResponseId     String
  csatResponse       CsatResponse     @relation(fields: [csatResponseId], references: [id], onDelete: Cascade)
  csatLinkQuestionId String
  csatLinkQuestion   CsatLinkQuestion @relation(fields: [csatLinkQuestionId], references: [id])
  score              Int

  @@index([csatResponseId])
  @@index([csatLinkQuestionId])
}

model CsatTemplate {
  id        String                 @id @default(cuid())
  name      String                 @unique
  isActive  Boolean                @default(true)
  sortOrder Int                    @default(0)
  questions CsatTemplateQuestion[]
}

model CsatTemplateQuestion {
  id         String       @id @default(cuid())
  templateId String
  template   CsatTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  text       String
  sortOrder  Int

  @@index([templateId])
}
